# Local environment template for the HOM voice bot.
# Copy to `.env` and fill in your keys:
#   cp .env.example .env

# --- Pipecat / LLM provider keys ---
# Set only the ones your pipeline uses (OpenAI, Anthropic, Deepgram, etc.)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ELEVENLABS_API_KEY=
# GROQ_API_KEY=

# --- Daily (WebRTC transport) ---
DAILY_API_KEY=
# DAILY_ROOM_URL=          # optional: reuse an existing room
# DAILY_ROOM_EXPIRY=3600   # seconds until auto-created rooms expire

# --- Deepgram (STT + TTS) ---
DEEPGRAM_API_KEY=
# DEEPGRAM_STT_MODEL=nova-2-general
# DEEPGRAM_TTS_VOICE=aura-asteria-en

# --- Google Gemini (LLM) ---
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Agent behavior ---
# AGENT_SYSTEM_PROMPT="You are a friendly voice assistant…"

# --- Server ---
PORT=8080
HOST=0.0.0.0

# --- Logging ---
LOG_LEVEL=INFO